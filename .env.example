# ─── GCP Configuration ─────────────────────────────────────────
# Your GCP project ID (find it in Cloud Console > Dashboard)
GCP_PROJECT_ID=gemini-unblocked

# Region where Vertex AI and Firestore run
GCP_LOCATION=europe-west2

# ─── Model Configuration ──────────────────────────────────────
# Gemini model for text/multimodal (options: gemini-2.0-flash, gemini-2.0-pro, gemini-1.5-pro)
MODEL_NAME=gemini-2.0-flash

# ─── Firestore ────────────────────────────────────────────────
FIRESTORE_DATABASE=(default)

# ─── App Ports ────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=8501
